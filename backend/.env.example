# Backend environment
# Copy to `backend/.env.production` for local production testing.
# Do not put GREENNODE_* runtime-injected variables here.

# Runs on Gemini through its OpenAI-compatible endpoint — see CLAUDE.md for why
# these three are load-bearing (planner timeouts, 429s, RPD ceilings).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_REASONING_EFFORT=low
LLM_MAX_CONCURRENCY=1
LLM_RETRY_ATTEMPTS=6
LLM_RETRY_MAX_WAIT_S=60
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Ceiling on the analysis phase of one turn, in seconds. Analysis skills queue one at
# a time behind LLM_MAX_CONCURRENCY; past this point the ones still queued are skipped
# and the answer is built from what finished. The assembler and the deck are exempt —
# they are the deliverable. See CLAUDE.md.
TURN_BUDGET_S=600

# Per-skill model overrides. Every entry here must have a matching key in
# llm/greennode.py:MODEL_MAPPING — an env var with no matching key is silently
# ignored (see CLAUDE.md "Adding a skill" step 6).
MODEL_SALES_ORCHESTRATOR=gemini-3.6-flash
MODEL_CENTRAL_AGENT=gemini-3.6-flash
MODEL_REQUIREMENT_ELICITATION=gemini-3.6-flash
MODEL_VALIDATION=gemini-3.6-flash
MODEL_MARKET_STRATEGY=gemini-3.6-flash
MODEL_PRODUCT_SOLUTION=gemini-3.6-flash
MODEL_COMPLIANCE=gemini-3.6-flash
MODEL_CLIENT_SIMULATOR=gemini-3.6-flash
MODEL_DESIGN=gemini-3.6-flash
MODEL_WIREFRAME_DESIGNER=gemini-3.6-flash
MODEL_DECK_EXTRACTOR=gemini-3.5-flash-lite
MODEL_PROPOSAL_ASSEMBLER=gemini-3.6-flash
MODEL_CS_AGENT=gemini-3.6-flash
MODEL_PREDICT_AGENT=gemini-3.6-flash

AGENTBASE_MEMORY_ID=mem_xxxxxxxxxxxx
MEMORY_STRATEGY_ID=strat_xxxxxxxxxxxx
AGENTBASE_GATEWAY_URL=https://your-gateway-url

SESSION_SECRET=change_me_in_production
SQLITE_DB_PATH=./data/sales_assistant.db
HOST=0.0.0.0
PORT=8080
FRONTEND_URL=https://sales-ai-agent-hackathon.vercel.app

# The knowledge path skills actually use (knowledge/loader.py) needs none of this.
# It only applies if KB_VECTOR_ENABLED=true re-enables the legacy LanceDB ingest.
KB_VECTOR_ENABLED=false
LANCEDB_PATH=./data/kb_runtime_cache
KB_EMBEDDING_PROVIDER=greennode
KB_EMBEDDING_MODEL=baai/bge-m3
KB_ENABLE_RERANKER=false
KB_RERANKER_MODEL=baai/bge-reranker-v2-m3

DEBUG=false
