# Claude Code — ignore only the machine-local settings. The rest of .claude/ is
# shared context: blanket-ignoring the directory meant anything written there for
# the team never left the machine that wrote it.
.claude/settings.local.json
.claude/*.local.json
.codex

# Environment
.env
.env.local
.env.production

# AgentBase credentials & cache (NEVER commit — contains IAM secrets / tokens)
.greennode.json
.agentbase/

# Local fallback data stores (SQLite memory + LanceDB vector store)
data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log
yarn-error.log
.pnpm-store/

# Frontend
.next/
out/
.cache/

# Build outputs
*.tsbuildinfo
next-env.d.ts

# Test
.pytest_cache/
.coverage
htmlcov/
.tox/

# Agent skill system artifacts
# **/SKILL.md
# **/reference/**

